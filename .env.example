# ============================================================
# Campus OS — Environment Variables Template
# Copy this file to '.env' and fill in your Firebase credentials.
# Note: For static HTML/JS deployments, values are also loaded via
# 'firebase-config.js' or window.CAMPUS_OS_FIREBASE_CONFIG
# ============================================================

# Core Firebase Web App Credentials
FIREBASE_API_KEY="AIzaSyYourActualApiKeyHere"
FIREBASE_AUTH_DOMAIN="campusos-83365.firebaseapp.com"
FIREBASE_PROJECT_ID="campusos-83365"
FIREBASE_STORAGE_BUCKET="campusos-83365.appspot.com"
FIREBASE_MESSAGING_SENDER_ID="1234567890"
FIREBASE_APP_ID="1:1234567890:web:campusos"

# Vite Framework Aliases (if building with Vite)
VITE_FIREBASE_API_KEY="AIzaSyYourActualApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="campusos-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="campusos-app"
VITE_FIREBASE_STORAGE_BUCKET="campusos-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:campusos"

# Next.js Framework Aliases (if building with Next.js)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourActualApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="campusos-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="campusos-app"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="campusos-app.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:campusos"

# Optional — Ask Desk / timetable-scan "AI repair" fallback.
# The deterministic OCR grid parser (Tesseract.js, always local) runs first
# and is used as-is whenever it's confident (non-empty, mostly-certain rows,
# AND covering a plausible chunk of a real week — see extractTimetableFromImage
# in app.js). These keys are only read when it isn't. Each of GEMINI_API_KEY,
# GROQ_API_KEY, and OPENROUTER_API_KEY independently enables a vision-based
# fallback that sends the scanned photo itself to that provider (see
# AIService.extractStructuredFromImage in app.js) — a bigger privacy step
# than the text-only repair below, since the image leaves the device.
# Configuring more than one lets the scanner rotate to the next provider
# (Gemini -> Groq -> OpenRouter, in that order) if one is out of free-tier
# quota or briefly down, instead of dropping all the way to unverified raw
# OCR. All three also gate a text-only fallback that sends just the
# OCR-extracted text (never the photo) to Gemini or Groq.
# Leave all three unset to run OCR/parsing fully offline with no third-party
# calls (the scan still works, it just isn't AI-verified — the preview modal
# will show an "Unverified scan" warning in that case).
# Read via firebase-config.js's getEnvVal() into window.CAMPUS_OS_GEMINI_KEY /
# window.CAMPUS_OS_GROQ_KEY / window.CAMPUS_OS_OPENROUTER_KEY.
GEMINI_API_KEY="your-gemini-api-key-here"
GROQ_API_KEY="your-groq-api-key-here"
OPENROUTER_API_KEY="your-openrouter-api-key-here"

{
  "name": "Clarity Desk",
  "short_name": "Clarity Desk",
  "description": "Student workflow layer that cuts app chaos and makes it clear what to do today instead of juggling five tools.",
  "start_url": "./index.html",
  "id": "/clarity-desk",
  "scope": ".",
  "display": "standalone",
  "background_color": "#171412",
  "theme_color": "#171412",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "chat",
          "accept": [
            "text/plain",
            ".txt",
            "application/zip",
            ".zip"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    { "name": "Today", "short_name": "Today", "description": "Mark today's classes and see what's next", "url": "./index.html#dashboard", "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Tasks", "short_name": "Tasks", "description": "What's due, and add a task", "url": "./index.html#assignments", "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Timetable", "short_name": "Timetable", "description": "Your week of classes", "url": "./index.html#timetable", "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./badge-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "monochrome"
    }
  ]
}
